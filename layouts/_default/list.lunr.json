
{{- $index := slice -}}
{{- range $page := $.Site.RegularPages -}}
    {{- $urlParts := split $page.RelPermalink "/" -}}
    {{- $version := index (first 3 $urlParts) 2 -}}
    {{- $scope := $version -}}

    {{- if eq (index $urlParts 1) "releases" -}}
        {{- $scope = "releases" -}}
    {{- end -}}

    {{- $index = $index | append (dict
        "title" $page.Title
        "content" ($page.Content | plainify | safeHTML)
        "version" $version
        "scope" $scope
        "href" $page.Permalink
        "summary" ($page.Summary | plainify | safeHTML)
        "path" ($page.Permalink | relURL)
    ) -}}
{{- end -}}
{{- $index | jsonify -}}
